# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret (https://dashboard.stripe.com/webhooks) — endpoint: /api/webhook, event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Offer (kept in env so the price can change without a redeploy of code)
OFFER_NAME="Formation Revente Hors-Piste"
OFFER_PRICE_CENTS=1000
OFFER_COMPARE_AT_CENTS=1500
OFFER_CURRENCY=eur

# Resend (https://resend.com/api-keys) — used to send the access email after payment
RESEND_API_KEY=re_xxx
EMAIL_FROM="Ridge <access@yourdomain.com>"

# Link sent to buyers to access the course content (Notion, Google Drive, membership area, etc.)
COURSE_ACCESS_URL=https://example.com/acces-formation
