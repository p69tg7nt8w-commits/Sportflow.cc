# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Offer name, used in the offer card and the access email subject/content
OFFER_NAME="Formation Revente Hors-Piste"

# Resend (https://resend.com/api-keys) — used to send the access email after signup
RESEND_API_KEY=re_xxx
